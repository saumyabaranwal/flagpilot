# ── dependencies ──────────────────────────────────────────
node_modules/
jspm_packages/
.pnp/
.pnp.*

# ── secrets  ⚠ COMMIT .env.example, NEVER .env ────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── build output ──────────────────────────────────────────
dist/
out/
build/
*.tsbuildinfo
.next/
coverage/

# ── VS Code extension specifics ───────────────────────────
# packaged extension bundles — build artefacts, never commit
*.vsix
# artefacts of the extension integration-test runner
.vscode-test/
.vscode-test-web/

# ── VS Code workspace  ────────────────────────────────────
# keep launch.json / tasks.json / extensions.json (the F5 debug
# config is part of the project and worth committing)
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# ── logs ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── MySQL dumps / local db files ──────────────────────────
*.sql.gz
*.dump
*.ibd

# ── OS + editor junk ──────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
